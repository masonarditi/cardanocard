# Photon project (app.photon.codes → Settings). Leave empty to chat in the terminal instead of iMessage.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Only these numbers can buy (comma separated).
OWNER_PHONES=
# Where orders ship (US).
DELIVERY_ADDRESS='{"street":"","city":"","state":"","zip":"","phone":"","name":""}'
# Channels to serve: imessage, whatsapp (enable WhatsApp in the Photon dashboard), telegram (needs a bot token).
CHANNELS=imessage
SPECTRUM_TELEGRAM_BOT_TOKEN=
# Telegram user IDs allowed to buy (the bot logs the ID of anyone it ignores).
OWNER_TELEGRAM_IDS=
