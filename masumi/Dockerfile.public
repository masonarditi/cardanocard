FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./
# Ship only the public registration endpoint, never the job runtime or card adapters.
COPY src/cardano_card/__init__.py src/cardano_card/models.py src/cardano_card/hosted_api.py ./src/cardano_card/
RUN pip install --no-cache-dir . && useradd --uid 10001 --create-home agent
USER agent
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080
EXPOSE 8080
CMD ["python", "-m", "cardano_card.hosted_api"]
