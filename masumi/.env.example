# All defaults are local simulations. No wallet or card is used.
CARDANO_CARD_MODE=local
CARDANO_CARD_DB=data/jobs.db
# Generate a local demo token; never use a real payment API key here.
CARDANO_CARD_TOKEN=
CARDANO_CARD_PORT=8080
CARDANO_CARD_FRONTEND=false
CARDANO_CARD_POLL_SECONDS=2

# Preprod remains off until the selected payment service passes compatibility tests.
# CARDANO_CARD_MODE=preprod
# MASUMI_V1_COMPATIBLE=false
# PAYMENT_SERVICE_URL=
# PAYMENT_API_KEY=
# AGENT_IDENTIFIER=
# SELLER_VKEY=
# MASUMI_FEE_LOVELACE=10000000
# BUYER_PAYMENT_SERVICE_URL=
# BUYER_PAYMENT_API_KEY=
# The setup CLI creates a separate ignored .env.preprod after confirmed registration.
# The acceptance CLI loads that file explicitly; normal app defaults stay simulated.

# replay exercises the durable AgentCard bridge with synthetic API responses.
PURCHASE_BACKEND=fake
FAKE_SCENARIO=success
# PURCHASE_BACKEND=replay
# REPLAY_SCENARIO=success
# Staged quote -> approval -> escrow -> checkout demo (both providers simulated).
# PURCHASE_BACKEND=staged_fake
# CARDANO_CARD_DB=data/staged-jobs.db
# PAYOUT_ADDRESS=SIM-payout
# MASUMI_FEE_LOVELACE=10000000
# After Mason supplies the v2 adapter and both sides pass acceptance:
# PURCHASE_BACKEND=staged_module
# MASON_STAGED_MODULE=your_reviewed_adapter
ALLOW_EXTERNAL_VAULT_CHECKOUT=false
VAULT_OPERATOR_EXCLUSIVE=false
# staged_module also requires CARDANO_CARD_MODE=preprod and a real PAYOUT_ADDRESS.
# These flags are deliberate run configuration, not proof of account readiness.

# AgentCard organization credentials. Never paste these in chat.
# Mason supplies matching sandbox credentials/tokens in ../agentcard/. Do not re-enroll.
# Root credentials are not substituted for the shared sandbox handoff.
AGENTCARD_CLIENT_ID=
AGENTCARD_CLIENT_SECRET=
