# Generated private values are written by scripts/prepare_masumi.py.
POSTGRES_PASSWORD=
ADMIN_KEY=
ENCRYPTION_KEY=

# Create a project with the Cardano Preprod network at https://blockfrost.io/.
# Paste the project key into the private .env file, not this template or chat.
BLOCKFROST_API_KEY_PREPROD=

# Optional existing test-wallet configuration. Empty means the node generates wallets.
PURCHASE_WALLET_PREPROD_MNEMONIC=
SELLING_WALLET_PREPROD_MNEMONIC=
# Empty uses the selling wallet as collection destination in this local test setup.
COLLECTION_WALLET_PREPROD_ADDRESS=
